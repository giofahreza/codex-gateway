{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IO Gateway Usage",
  "version": "0.1.0",
  "identifier": "dev.yow.io-gateway.usage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IO Gateway Usage",
        "width": 1180,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Desktop usage monitor for IO Gateway",
    "longDescription": "A desktop usage and quota monitor for a running local IO Gateway instance."
  }
}
